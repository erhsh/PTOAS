// TileLang ST smoke-test kernel for pto.tinsert Acc→Mat NZ path (cube kernel).
//
// LIMITATION: In a cube kernel, L1 data is NOT observable from GM.
// Only the matmul result (via mte_l0c_gm) is verifiable. The tinsert
// behavior (offset, layout) is a smoke test only.
//
// NOTE: The ptoas compiler currently does NOT support `pre_relu` attribute
// on pto.tinsert. The Acc→Mat NZ+ReLU path cannot be tested until ptoas
// forwards `pre_relu` to the template selector via context_attrs.
//
// Pipeline: GM(A,B)→L1→L0A/L0B→L0C(tmatmul)→L1(tinsert Acc→Mat NZ smoke)→GM(mte_l0c_gm)
// Compiled by ptoas --enable-insert-sync --enable-tile-op-expand --pto-backend=vpto

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<cube>} {

  // Smoke test: tmatmul + tinsert Acc→Mat NZ (nz2nz, idx=0,0) + mte_l0c_gm output
  func.func @TINSERT_ACC_MAT_NZ_f32_16x16_idx0_0(%a_gm: !pto.ptr<f16, gm>, %b_gm: !pto.ptr<f16, gm>, %out_gm: !pto.ptr<f32, gm>) attributes {pto.aicore} {
    %c0_i64 = arith.constant 0 : i64
    %c1_i64 = arith.constant 1 : i64
    %c16_i64 = arith.constant 16 : i64
    %c32_i64 = arith.constant 32 : i64
    %c512_i64 = arith.constant 512 : i64
    %c1024_i64 = arith.constant 1024 : i64
    %false = arith.constant false
    %idx_r0 = arith.constant 0 : index
    %idx_c0 = arith.constant 0 : index

    %l1_a_tile = pto.alloc_tile addr = %c0_i64 : !pto.tile_buf<mat, 16x16xf16, blayout=col_major, slayout=row_major>
    %l1_b_tile = pto.alloc_tile addr = %c512_i64 : !pto.tile_buf<mat, 16x16xf16, blayout=col_major, slayout=row_major>
    %l0a_tile = pto.alloc_tile addr = %c0_i64 : !pto.tile_buf<left, 16x16xf16, blayout=col_major, slayout=row_major>
    %l0b_tile = pto.alloc_tile addr = %c0_i64 : !pto.tile_buf<right, 16x16xf16, blayout=row_major, slayout=col_major>
    %l0c_tile = pto.alloc_tile addr = %c0_i64 : !pto.tile_buf<acc, 16x16xf32, blayout=col_major, slayout=row_major, fractal=1024>

    %l1_a = pto.tile_buf_addr %l1_a_tile : !pto.tile_buf<mat, 16x16xf16, blayout=col_major, slayout=row_major> -> !pto.ptr<f16, l1>
    %l1_b = pto.tile_buf_addr %l1_b_tile : !pto.tile_buf<mat, 16x16xf16, blayout=col_major, slayout=row_major> -> !pto.ptr<f16, l1>
    %l0a = pto.tile_buf_addr %l0a_tile : !pto.tile_buf<left, 16x16xf16, blayout=col_major, slayout=row_major> -> !pto.ptr<f16, l0a>
    %l0b = pto.tile_buf_addr %l0b_tile : !pto.tile_buf<right, 16x16xf16, blayout=row_major, slayout=col_major> -> !pto.ptr<f16, l0b>

    pto.mte_gm_l1_frac %a_gm, %l1_a, nd2nz,
      shape(%c16_i64, %c16_i64),
      src_layout(%c32_i64),
      dst_group(%c1_i64, %c1_i64, %c16_i64, %c0_i64),
      ctrl(%c0_i64, %false)
      : !pto.ptr<f16, gm>, !pto.ptr<f16, l1>, nd2nz,
        shape i64, i64, src_layout(i64),
        dst_group i64, i64, i64, i64, ctrl i64, i1
    pto.set_flag["PIPE_MTE2", "PIPE_MTE1", "EVENT_ID0"]
    pto.wait_flag["PIPE_MTE2", "PIPE_MTE1", "EVENT_ID0"]
    pto.mte_l1_l0a %l1_a, %l0a, %c16_i64, %c16_i64 : !pto.ptr<f16, l1>, !pto.ptr<f16, l0a>, i64, i64

    pto.mte_gm_l1_frac %b_gm, %l1_b, nd2nz,
      shape(%c16_i64, %c16_i64),
      src_layout(%c32_i64),
      dst_group(%c1_i64, %c1_i64, %c16_i64, %c0_i64),
      ctrl(%c0_i64, %false)
      : !pto.ptr<f16, gm>, !pto.ptr<f16, l1>, nd2nz,
        shape i64, i64, src_layout(i64),
        dst_group i64, i64, i64, i64, ctrl i64, i1
    pto.set_flag["PIPE_MTE2", "PIPE_MTE1", "EVENT_ID1"]
    pto.wait_flag["PIPE_MTE2", "PIPE_MTE1", "EVENT_ID1"]
    pto.mte_l1_l0b %l1_b, %l0b, %c16_i64, %c16_i64 {transpose = true} : !pto.ptr<f16, l1>, !pto.ptr<f16, l0b>, i64, i64

    pto.set_flag["PIPE_MTE1", "PIPE_M", "EVENT_ID0"]
    pto.wait_flag["PIPE_MTE1", "PIPE_M", "EVENT_ID0"]
    pto.tmatmul ins(%l0a_tile, %l0b_tile : !pto.tile_buf<left, 16x16xf16, blayout=col_major, slayout=row_major>,
                                         !pto.tile_buf<right, 16x16xf16, blayout=row_major, slayout=col_major>)
                outs(%l0c_tile : !pto.tile_buf<acc, 16x16xf32, blayout=col_major, slayout=row_major, fractal=1024>)

    // --- tinsert smoke test: L0C → L1 Mat NZ (nz2nz, idx=0,0) ---
    // dst mat tile is allocated in L1 but content is NOT observable from GM in cube kernel
    %dst = pto.alloc_tile addr = %c1024_i64 : !pto.tile_buf<loc=mat, dtype=f32, rows=32, cols=32, v_row=32, v_col=32,
                                          blayout=col_major, slayout=row_major, fractal=512, pad=0>

    pto.tinsert ins(%l0c_tile, %idx_r0, %idx_c0 : !pto.tile_buf<acc, 16x16xf32, blayout=col_major, slayout=row_major, fractal=1024>, index, index)
             outs(%dst : !pto.tile_buf<loc=mat, dtype=f32, rows=32, cols=32, v_row=32, v_col=32,
                            blayout=col_major, slayout=row_major, fractal=512, pad=0>)

    // --- Output: L0C → GM (matmul result verification) ---
    pto.set_flag["PIPE_M", "PIPE_FIX", "EVENT_ID0"]
    pto.wait_flag["PIPE_M", "PIPE_FIX", "EVENT_ID0"]
    %l0c = pto.tile_buf_addr %l0c_tile : !pto.tile_buf<acc, 16x16xf32, blayout=col_major, slayout=row_major, fractal=1024> -> !pto.ptr<f32, l0c>

    pto.mte_l0c_gm %l0c, %out_gm, %c16_i64, %c16_i64, %c16_i64, %c16_i64, %c0_i64, %c0_i64,
      nz2nd
      : !pto.ptr<f32, l0c>, !pto.ptr<f32, gm>, i64, i64, i64, i64, i64, i64
    pto.barrier #pto.pipe<PIPE_ALL>
    return
  }
}