      sizes = [%c1, %c1, %c1, %c16, %c16]
      : !pto.tensor_view<1x1x1x16x16xf16> -> !pto.partition_tensor_view<1x1x1x16x16xf16>

    %dst_init_view = pto.make_tensor_view %dst_init_ptr,
      shape = [%c1, %c1, %c1, %c32, %c32],
      strides = [%c1024, %c1024, %c1024, %c32, %c1]
      : !pto.tensor_view<1x1x1x32x32xf16>
    %dst_init_part = pto.partition_view %dst_init_view,
      offsets = [%c0, %c0, %c0, %c0, %c0],
      sizes = [%c1, %c1, %c1, %c32, %c32]
      : !pto.tensor_view<1x1x1x32x32xf16> -> !pto.partition_tensor_view<1x1x1x32x32xf16>

    %out_view = pto.make_tensor_view %out_ptr,
      shape = [%c1, %c1, %c1, %c32, %c32],
      strides = [%c1024, %c1024, %c1024, %c32, %c1]
      : !pto.tensor_view<1x1x1x32x32xf16>
    %out_part = pto.partition_view %out_view,
      offsets = [%c0, %c0, %c0, %c0, %c0],
      sizes = [%c1, %c1, %c1, %c32, %c32]
      : !pto.tensor_view<1x1x1x32x32xf16> -> !pto.partition_tensor_view<1x1x1x32x32xf16>

    %src = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf16>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 32x32xf16>

    pto.tload ins(%src_part : !pto.partition_tensor_view<1x1x1x16x16xf16>)
              outs(%src : !pto.tile_buf<vec, 16x16xf16>)

    pto.tload ins(%dst_init_part : !pto.partition_tensor_view<1x1x1x32x32xf16>)
              outs(%dst : !pto.tile_buf<vec, 32x32xf16>)

    pto.tinsert ins(%src, %idx_r0, %idx_c5 : !pto.tile_buf<vec, 16x16xf16>, index, index)
             outs(%dst : !pto.tile_buf<vec, 32x32xf16>)

    pto.tstore ins(%dst : !pto.tile_buf<vec, 32x32xf16>)
               outs(%out_part : !pto.partition_tensor_view<1x1x1x32x32xf16>)
    return
  }
}