  // Case 0: f32 8x8 -> 16x16 idx(0,0)
  func.func @TINSERT_f32_8x8_to_16x16_idx0_0(%src_ptr: !pto.ptr<f32>, %dst_init_ptr: !pto.ptr<f32>, %out_ptr: !pto.ptr<f32>) attributes {pto.aicore} {
    %c0     = arith.constant 0     : index
    %c1     = arith.constant 1     : index
    %c8     = arith.constant 8     : index
    %c16    = arith.constant 16    : index
    %c64    = arith.constant 64    : index
    %c256   = arith.constant 256   : index
    %idx_r0 = arith.constant 0     : index
    %idx_c0 = arith.constant 0     : index

    // src view: 8x8
    %src_view = pto.make_tensor_view %src_ptr,
      shape = [%c1, %c1, %c1, %c8, %c8],
      strides = [%c64, %c64, %c64, %c8, %c1]
      : !pto.tensor_view<1x1x1x8x8xf32>
    %src_part = pto.partition_view %src_view,
      offsets = [%c0, %c0, %c0, %c0, %c0],
      sizes = [%c1, %c1, %c1, %c8, %c8]
      : !pto.tensor_view<1x1x1x8x8xf32> -> !pto.partition_tensor_view<1x1x1x8x8xf32>

    // dst_init view: 16x16
    %dst_init_view = pto.make_tensor_view %dst_init_ptr,
      shape = [%c1, %c1, %c1, %c16, %c16],
      strides = [%c256, %c256, %c256, %c16, %c1]
      : !pto.tensor_view<1x1x1x16x16xf32>
    %dst_init_part = pto.partition_view %dst_init_view,
      offsets = [%c0, %c0, %c0, %c0, %c0],
      sizes = [%c1, %c1, %c1, %c16, %c16]
      : !pto.tensor_view<1x1x1x16x16xf32> -> !pto.partition_tensor_view<1x1x1x16x16xf32>

    // output view: 16x16
    %out_view = pto.make_tensor_view %out_ptr,
      shape = [%c1, %c1, %c1, %c16, %c16],
      strides = [%c256, %c256, %c256, %c16, %c1]
      : !pto.tensor_view<1x1x1x16x16xf32>
    %out_part = pto.partition_view %out_view,
      offsets = [%c0, %c0, %c0, %c0, %c0],
      sizes = [%c1, %c1, %c1, %c16, %c16]
      : !pto.tensor_view<1x1x1x16x16xf32> -> !pto.partition_tensor_view<1x1x1x16x16xf32>

    %src = pto.alloc_tile : !pto.tile_buf<vec, 8x8xf32>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf32>

    pto.tload ins(%src_part : !pto.partition_tensor_view<1x1x1x8x8xf32>)
              outs(%src : !pto.tile_buf<vec, 8x8xf32>)

    pto.tload ins(%dst_init_part : !pto.partition_tensor_view<1x1x1x16x16xf32>)
              outs(%dst : !pto.tile_buf<vec, 16x16xf32>)

    pto.tinsert ins(%src, %idx_r0, %idx_c0 : !pto.tile_buf<vec, 8x8xf32>, index, index)
             outs(%dst : !pto.tile_buf<vec, 16x16xf32>)

    pto.tstore ins(%dst : !pto.tile_buf<vec, 16x16xf32>)
               outs(%out_part : !pto.partition_tensor_view<1x1x1x16x16xf32>)
    return
  }

