// Test pto.tinsert (Vec→Vec ND) DMA path with i32 dtype.
// i32, src shape 16x16 valid_shape 16x16 -> dst 32x32
// stride=16 -> 16*4=64 -> 32B-aligned
// validCol=16 -> 16*4=64 -> 32B-aligned
//
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --enable-tile-op-expand %s -o - 2>/dev/null | FileCheck %s

// CHECK: func.func @TINSERT_I32_VEC_ND
// CHECK-NOT: pto.tinsert ins
// CHECK: pto.castptr
// CHECK: pto.copy_ubuf_to_ubuf

module attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @TINSERT_I32_VEC_ND() {
    %c0 = arith.constant 0 : index
    %c8 = arith.constant 8 : index

    %src = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=i32, rows=16, cols=16, v_row=16, v_col=16,
                       blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=i32, rows=32, cols=32, v_row=32, v_col=32,
                       blayout=row_major, slayout=none_box, fractal=512, pad=0>

    pto.tinsert ins(%src, %c8, %c0 : !pto.tile_buf<loc=vec, dtype=i32, rows=16, cols=16, v_row=16, v_col=16,
                              blayout=row_major, slayout=none_box, fractal=512, pad=0>,
                          index, index)
             outs(%dst : !pto.tile_buf<loc=vec, dtype=i32, rows=32, cols=32, v_row=32, v_col=32,
                           blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    return
  }
}