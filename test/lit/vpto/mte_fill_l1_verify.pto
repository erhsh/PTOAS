  func.func @test() attributes {pto.kernel} {
    %c0 = arith.constant 0 : i64
    %bad = arith.constant 32768 : i64
    %dst = pto.castptr %c0 : i64 -> !pto.ptr<ui16, l1>
    pto.mte_fill_l1 %dst, %c0, %c0, %c0, %bad, %c0, 16 : !pto.ptr<ui16, l1>, i64, i64, i64, i64, i64
    return
  }
